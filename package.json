{
  "name": "pokedex-frontend-interview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --write .",
"test:e2e": "cucumber-js \"tests/e2e/features/**/*.feature\" --import ts-node/esm --import \"tests/e2e/steps/**/*.ts\" --import \"tests/e2e/support/**/*.ts\" --format json:tests/reports/cucumber-report.json",
  "report:html": "cucumber-html-reporter --theme bootstrap --jsonFile tests/reports/cucumber-report.json --output tests/reports/cucumber-html/report.html",
  "test:e2e:html": "npm run test:e2e && npm run report:html",
  "test:e2e:report": "npm run test:e2e && npm run report:html",
    "allure:generate": "allure generate tests/reports/allure-results -o tests/reports/allure-report --clean",
    "allure:open": "allure open tests/reports/allure-report",
    "report": "allure generate tests/reports/allure-results --clean -o tests/reports/allure-report && allure open tests/reports/allure-report",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.4.1",
    "allure-playwright": "^3.4.1",
    "cross-env": "^10.0.0",
    "cucumber-html-reporter": "^7.2.0",
    "cucumberjs-allure2-reporter": "^1.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.8",
    "jsdom": "^27.0.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vite": "^5.4.1",
    "vitest": "^3.2.4"
  }
}
